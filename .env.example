# ==========================================================================
# Repositorio Institucional - Variables de entorno (EJEMPLO, no usar secretos)
# Copiar a .env y completar. Nunca versionar .env.
# ==========================================================================

APP_NAME="Repositorio Institucional"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=America/Lima
APP_LOCALE=es_PE
APP_KEY=
INSTALLATION_MODE=single
TENANCY_MODE=single

# Base de datos MySQL 8.x / MariaDB 10.6+
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=repositorio_institucional
DB_USERNAME=repo_user
DB_PASSWORD=
DB_CHARSET=utf8mb4

SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=Lax
SESSION_LIFETIME_MINUTES=120

# Almacenamiento privado (fuera de public/)
STORAGE_DRIVER=local_private
STORAGE_PRIVATE_PATH=
UPLOAD_MAX_MB=50
UPLOAD_MAX_FILES=10
UPLOAD_ALLOWED_TYPES=pdf,docx,xlsx,pptx,csv,jpg,jpeg,png,zip

QUEUE_DRIVER=database
MAIL_DRIVER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-responder@example.invalid
MAIL_FROM_NAME="Repositorio Institucional"

OAI_ENABLED=true
OAI_REPOSITORY_IDENTIFIER=
OAI_ADMIN_EMAIL=
OPEN_API_ENABLED=true
ANTIVIRUS_ENABLED=false
OCR_ENABLED=false
BACKUP_ENCRYPTION_KEY=
